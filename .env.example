# Copy this file to `.env` and fill in your keys.
# `.env` is git-ignored — never commit real keys, and never put them in THIS file.

# --- Model provider -----------------------------------------------------
# Pick one. If both keys are set, OpenAI is used unless you say otherwise:
# LLM_PROVIDER=openai      # or: gemini

# --- OpenAI (paid — needs credit on your account) -----------------------
# Key from https://platform.openai.com/api-keys
# Billing: https://platform.openai.com/settings/organization/billing
OPENAI_API_KEY=

# Optional. Defaults to gpt-5.6. A smaller model is much cheaper and is
# plenty for looking a fact up and reporting it — e.g. gpt-4o-mini.
# OPENAI_MODEL=gpt-5.6

# --- Google AI / Gemini (has a free tier, but a tight quota) ------------
# Free key from https://aistudio.google.com/apikey
# Your live limits: https://aistudio.google.com/rate-limit
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.5-flash-lite, which has a bigger free-tier
# allowance than the full flash model — one question costs several calls, and
# the larger model rate-limits mid-answer on the free tier.
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional. Reasoning depth: low | medium | high. Defaults to "low" —
# thinking tokens dominate both latency and the free-tier quota.
# GEMINI_THINKING=low

# --- TMDB (free) --------------------------------------------------------
# Free key from https://www.themoviedb.org/settings/api
# That page shows two credentials — paste EITHER one here:
#   * "API Read Access Token" (a long token with dots) -> used as a Bearer header
#   * "API Key" (a short hex string)                   -> used as a query param
TMDB_API_KEY=

# --- Server -------------------------------------------------------------
# PORT=3000
